<!DOCTYPE html>
<html lang="ha">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Heart</title>
    <style>
        body {
            background-color: #0d1117;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            font-family: monospace;
            color: #00ff66;
        }

        /* 1. TSARIN ZUCIYAR DA AKE ZANAWA (ANIMATION) */
        .heart {
            background-color: #ff3366;
            display: inline-block;
            height: 60px;
            position: relative;
            transform: rotate(-45deg);
            width: 60px;
            
            /* Sanya motsi (Animation) */
            animation: drawHeart 2s ease-in-out forwards;
            opacity: 0; /* Boyayye a farko */
        }

        .heart:before,
        .heart:after {
            content: "";
            background-color: #ff3366;
            border-radius: 50%;
            height: 60px;
            position: absolute;
            width: 60px;
        }

        .heart:before {
            top: -30px;
            left: 0;
        }

        .heart:after {
            left: 30px;
            top: 0;
        }

        /* MOTSIN ZANA ZUCIYAR (KEYFRAMES) */
        @keyframes drawHeart {
            0% {
                transform: scale(0) rotate(-45deg);
                opacity: 0;
            }
            50% {
                transform: scale(1.2) rotate(-45deg);
                opacity: 0.7;
            }
            100% {
                transform: scale(1) rotate(-45deg);
                opacity: 1;
            }
        }

        /* 2. RUBUTU KO HOTO DA ZAI BAYYANA BAYAN AN GAMA ZANA ZUCIYAR */
        .content-after {
            margin-top: 50px;
            font-size: 1.2rem;
            opacity: 0;
            animation: fadeInContent 1.5s ease-in-out 2s forwards; /* Motsi zai fara bayan dakika 2 */
        }

        @keyframes fadeInContent {
            to {
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <!-- Siffar Zuciya Mai Motsi -->
    <div class="heart"></div>

    <!-- Abin da zai bayyana a ƙasa bayan zuciyar ta gama zanuwa -->
    <div class="content-after">
        <p>❤️ Barka da zuwa shafin sirri!</p>
    </div>

</body>
</html>
